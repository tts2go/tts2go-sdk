{
  "name": "@tts2go/embed",
  "version": "1.1.0",
  "main": "dist/index.global.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format iife --global-name TTS2GoEmbed --minify --dts",
